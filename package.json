{
  "name": "receipt-validator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply receipt-validator-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply receipt-validator-db --remote",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "ci:build": "wrangler deploy --dry-run --outdir .wrangler/ci-build"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.30.0"
  }
}
